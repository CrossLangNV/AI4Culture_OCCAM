<?xml version="1.0" encoding="UTF-8"?>
<srx xmlns="http://www.lisa.org/srx20" xmlns:okpsrx="http://okapi.sf.net/srx-extensions" version="2.0">
  <header cascade="yes" segmentsubflows="yes">
    <formathandle include="no" type="start"/>
    <formathandle include="yes" type="end"/>
    <formathandle include="yes" type="isolated"/>
    <okpsrx:options oneSegmentIncludesAll="no" trimLeadingWhitespaces="yes" trimTrailingWhitespaces="yes" useJavaRegex="no"/>
    <okpsrx:sample language="en" useMappedRules="yes"/>
    <okpsrx:rangeRule/>
  </header>
  <body>
    <languagerules>
      <languagerule languagerulename="Arabic">
        <rule break="no">
          <beforebreak>\s+[أي|اي|آي|بي|سي|دي|إي|اف|إف|جي|دجي|إتش|كي|إل|ال|ام|إم|ان|إن|أو|او|كيو|أر|ار|آر|اس|إس|تي|يو|في|دبليو|اكس|إكس|واي|زي|زيد]\.</beforebreak>
          <afterbreak>\s+[أي|اي|آي|بي|سي|دي|إي|اف|إف|جي|دجي|إتش|كي|إل|ال|ام|إم|ان|إن|أو|او|كيو|أر|ار|آر|اس|إس|تي|يو|في|دبليو|اكس|إكس|واي|زي|زيد]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>\s+[ا‎أآاإب‎ت‎ث‎ج‎ح‎خ‎ده‎ذ‎ر‎ز‎س‎ش‎ص‎ض‎ط‎ظ‎ع‎ؤةغ‎ف‎ق‎ك‎ل‎م‎ن‎0-9يء]\.</beforebreak>
          <afterbreak>\s+[ا‎أآاإب‎ت‎ث‎ج‎ح‎خ‎ده‎ذ‎ر‎زي‎س‎ش‎ص‎ض‎ط‎ظ‎ع‎غ‎ف‎ق‎ك‎ل‎م‎ن‎و‎0-9]</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>(^|\s+|[\(\[\،\:\؛\"\-])\.</beforebreak>
          <afterbreak>\s+\"</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\،\:\؛\"\-])\.</beforebreak>
          <afterbreak>\s+</afterbreak>
        </rule>
      </languagerule>
      <languagerule languagerulename="Armenian">
	<!-- Abbreviations -->      
      <rule break="no">
          <beforebreak>(^|\s+)(արլ|արմ|բն|բրբ|գլխ|դ|դդ|հզ|հզվդ|հնց|հս|հվ|մ\.թ|մ\.թ\.ա|մլն|մլրդ|պատմ)\.</beforebreak>
          <afterbreak>\s+</afterbreak>
        </rule>
	<!-- Abbreviations followed by a number -->
	<rule break="no">
          <beforebreak>(^|\s+)(երկ)\.</beforebreak>
          <afterbreak>\s+\d+</afterbreak>
        </rule>
        <!-- Initials Վ. Լ. -->
        <rule break="no">
	  <beforebreak>\s+[ՊպԲբՖֆՎվՄմՏտԴդԹթՁձՆնԿկԳգԽխՂղՍսԶզՇշԺժՃճՋջՒւՌռԼլՅյՀհԱաԷէԵեԸըԻիՅյՈոՈՈոոՒւՈՒուԱԻաիԱՒաւՈԻոիՕօԵԻեիԻԸիըՒԸւըՅՒյւԱԻԸաիըԱՒԸաւըՅՒԸյւըմնմեմի]\.</beforebreak>
          <afterbreak>\s+</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>\s+[ՊպԲբՖֆՎվՄմՏտԴդԹթՁձՆնԿկԳգԽխՂղՍսԶզՇշԺժՃճՋջՒւՌռԼլՅյՀհԱաԷէԵեԸըԻիՅյՈոՈՈոոՒւՈՒուԱԻաիԱՒաւՈԻոիՕօԵԻեիԻԸիըՒԸւըՅՒյւԱԻԸաիըԱՒԸաւըՅՒԸյւըմնմեմի]\.(\s+)?[ՊպԲբՖֆՎվՄմՏտԴդԹթՁձՆնԿկԳգԽխՂղՍսԶզՇշԺժՃճՋջՒւՌռԼլՅյՀհԱաԷէԵեԸըԻիՅյՈոՈՈոոՒւՈՒուԱԻաիԱՒաւՈԻոիՕօԵԻեիԻԸիըՒԸւըՅՒյւԱԻԸաիըԱՒԸաւըՅՒԸյւըմնմեմի]\.</beforebreak>
          <afterbreak>\s+</afterbreak>
        </rule>
        <!-- Armenian full stop (not the same char between brackets) -->       
	<rule break="yes">
	  <beforebreak>.[\:։]</beforebreak>
	  <afterbreak>\s+</afterbreak>
       </rule>
      </languagerule>
      <languagerule languagerulename="Burmese">
        <rule break="no">
          <beforebreak>(^[၀၁၂၃၄၅၆၇၈၉]+[။])</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>[။]</beforebreak>
          <afterbreak>[\”\)]\s*</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>[။][”]*</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>.[\.;]</beforebreak>
          <afterbreak>\s+</afterbreak>
        </rule>
      </languagerule>
      <languagerule languagerulename="Chinese">
        <rule break="yes">
          <!-- Empty space rules should be protected by '( )', otherwise some XML reader have trouble treating them correctly. -->
          <beforebreak>( )</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>[…,；。！？，\?\!;\.﹔﹕﹖﹗][”」]</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>[…；。！？\?\!﹔﹕﹖﹗]+\s+</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>\p{Han}[…；。！？﹔﹕﹖﹗]</beforebreak>
          <afterbreak>[^”」]</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>[…；。！？\?\!﹔﹕﹖﹗]</beforebreak>
          <afterbreak>\p{Han}</afterbreak>
        </rule>
        <rule break="yes">
          <afterbreak>\p{Han}</afterbreak>
          <beforebreak>[︓︰﹕：]</beforebreak>
        </rule>
        <rule break="no">
          <beforebreak>[\.．]</beforebreak>
          <afterbreak>[0-9A-Za-z０１２３４５６７８９ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺ％ａｂｃｄｅｆｇｈｉｊｋｌｍｎｏｐｑｒｓｔｕｖｗｘｙｚ／\/]</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>[…；。！？﹔﹕﹖﹗]+</beforebreak>
          <afterbreak>[^”」]</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>\p{Han}[\?\!;\|\]]</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>\p{Han}[\.]+</beforebreak>
          <afterbreak>[^\.]</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>．</beforebreak>
          <afterbreak>[^0-9A-Za-z０１２３４５６７８９]</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>[日专]电</beforebreak>
          <afterbreak>[\s\(（]</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>(报道|电)】</beforebreak>
          <afterbreak>.</afterbreak>
        </rule>
      </languagerule>
      <languagerule languagerulename="Croatian">
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(Jan|Feb|Mar|Apr|Maj|Jun|Jul|Avg|Sept|Okt|Nov|Dec|jan|feb|mar|apr|jun|jul|avg|sep|okt|nov|dec)\.</beforebreak>
          <afterbreak>\s*[a-š0-9šđćžč]+</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(Prof\.dr|prof\.dr|dr|Dr|gov|Gov|gđa|prof|Prof|tzv|TZV|Tzv|lat|eng|tur|srp|pol|fr|grč|tj|inž|sv|Sv|st|St|mr|Mr|akad|ing|Ing|sc|Bl|bl|BL|gosp|Gosp)\.</beforebreak>
          <afterbreak>\s*[a-šA-ŠĐŽĆČ0-9šđćžč"]+</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(npr|Npr|id|Id|ID|vs|Vs|N\.B|p\.s|P\.s|P\.S|mil|spec|Spec|SPEC|el|EL|reg|Reg|tel|Tel|TEL|tj|med|Med|mob|Mob|telef|podrazum|Podrazum|dipl|Dipl|i dr|ul|Ul|www|Ltd|ltd|op|Op|čl|Čl)\.</beforebreak>
          <afterbreak>\s*[a-š0-9"]+</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(fig|Fig|FIG|str|Str|STR|vol|Vol|VOL|br|Br|BR|god)\.</beforebreak>
          <afterbreak>\s*[\da-š0-9šđćžč]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(Jan|Feb|Mar|Apr|Maj|Jun|Jul|Avg|Sept|Okt|Nov|Dec|jan|feb|mar|apr|jun|jul|avg|sep|okt|nov|dec)\.</beforebreak>
          <afterbreak>\s*\d+</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>\d+\.</beforebreak>
          <afterbreak>(^|\s+|[\(\[\,\:\;\"\-])(Jan|Feb|Mar|Apr|Maj|Jun|Jul|Avg|Sept|Okt|Nov|Dec|jan|feb|mar|apr|jun|jul|avg|sep|okt|nov|dec)</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>\d\.</beforebreak>
          <afterbreak>\d</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>\d\s?[g|G]\.</beforebreak>
          <afterbreak>\s[a-šđćžč]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>[a-šа-ш]\s?[g|G]\.</beforebreak>
          <afterbreak>\s[A-ŠĐŽĆČ]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>^[\dIVXLCMivxlcm]+\.</beforebreak>
          <afterbreak>\s[a-šđćžč]+</afterbreak>
        </rule>
        <!--  T. Nikola -->
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\»\-\'\(])([A-Š])\.</beforebreak>
          <afterbreak>\s[A-ŠĐŽĆČ][a-šđćžč]*</afterbreak>
        </rule>
        <!--  Tesla N. -->
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\»\-\'])[A-ŠĐŽĆČ][a-šđćžč]+\s([A-ŠĐŽĆČ])\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
        <!--  S.W.A.T. -->
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\»\-\'])([A-ŠĐŽĆČ]\.)+</beforebreak>
          <afterbreak>\s*[a-šA-ŠđćžčŠĐŽĆČ]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>\d\s?\.</beforebreak>
          <afterbreak>\s*[a-šđćžč]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\.\»\-\'\(])[\dIVXLCM]+\.</beforebreak>
          <afterbreak>\s*[a-šđćžčA-ŠĐŽĆČ]+</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>\s?\.\.\.</beforebreak>
          <afterbreak>\s*[a-šđćžč0-9]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>\s?[\:|\;]</beforebreak>
          <afterbreak>\s*["a-šđćžčA-ŠĐŽĆČ0-9]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\»\-\'])[a-š]+\.</beforebreak>
          <afterbreak>\s([a-šđćžčA-ŠĐŽĆČ])\.\s([A-ŠĐŽĆČ])\.\s[A-ŠĐŽĆČ][a-šđćžč]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>[a-šđćžč]\.</beforebreak>
          <afterbreak>com|rs|fr|org</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\»\-\'])(itd|i sl|i dr)\.</beforebreak>
          <afterbreak>\s*[a-šđćžč]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\»\-\'])(prof|Prof)\.</beforebreak>
          <afterbreak>\s*dr\.[A-ŠĐŽĆČ]</afterbreak>
        </rule>
      </languagerule>
      <languagerule languagerulename="Czech">
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(odst|čl|písm|věst|s|např|č)\.</beforebreak>
          <afterbreak>\s</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(Ian|Jan|Jaan|Tam|Sau|Led|Feb|Veeb|Hel|Vas|Un|Mar|Mär|Maal|Kov|Břez|Már|Apr|Huht|bal|dub|ápr|Mai|Maj|Maijs|Touk|geguž|máj|Iun|Jun|Jūn|Juun|Kes|birž|jún|Iul|Jul|Jūl|Juul|Hein|liep|júl|Aot|Aug|Elok|rugp|srp|avg|Sept|Syysk|rugs|szept|Oct|Okt|Lok,spal|rij|Noi|Nov|Mar|lapk|list|Dec|Det|Joul|gruod|prosjan|Jan|feb|Feb|mar|Mar|apr|Apr|jun|Jun|jul|Jul|aug|Aug|sep|Sep|sept|Sept|oct|Oct|nov|Nov|dec|Dec|Mon|Tue|Tues|Wed|Thu|Thurs|Fri|Sat|Sun|capt|Capt|dr|Dr|gov|Gov|gen|Gen|Mr|Mrs|Ms|Mme|prof|Prof|sgt|Sgt|st|St|Col|Rev|Sen|b\.c|B\.c|B\.J|a\.c|A\.c|av|Av|Co|corp|Corp|dept|Dept|dir|esp|Esp|D\.C|D\.P\.R\.K|D\.S|Fla|F\.W|gov|Gov|govt|Govt|inc|Inc|J\.D|J\.R|J\.T|Jr|Sr|Snr|L\.A|ltd|Lt|Ltd|mfg|M|Mfg|M\.B|M\.C|McG|Mt|M\.T\.M|N\.Y|O\.K|P\.F\.E|Sdn|S\.A|S\.A\.R\.L|S\.O\.S|S\.G|T\.R|U\.K|U\.S|U\.S\.A|V\.W\.H|W\.V|a\.m|A\.m|ca|Ca|cf|Cf|e\.g|E\.g|al|Al|ca|Ca|A\.D|etc|Etc|id|Id|q\.e\.d|Q\.e\.d|vs|Vs|seq|Seq|ib|Ib|ibid|Ibid|i\.e|I\.e|cit|Cit|N\.B|p\.m|P\.m|p\.m|P\.m|p\.s|P\.s|q\.v|Q\.v|sc|Sc|v|V|viz|Viz|v\.v|V\.v|fig|Fig|chap|Chap|no|No|p|pg|Pg|pp|Pp|vol|Vol|C|W|approx|addt|addtl|incl|op|Op|Pr|Hr|E|Dž|ž|P|Dl|Dn|Dra|Ga|ga|p|e|ge|g)\.</beforebreak>
          <afterbreak>\s*[A-ZÁÃÄÅÀÂÆÇČÊËÉÈÍÌÎÏÑŒÓÔÕØÖŠÙÚÜÛŸÝa-zçéèêëàâäáæîïíìôöòõóøœřšûüùúñÿý0-9]+</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(capt|Capt|dr|Dr|gov|Gov|gen|Gen|Mr|Mrs|Ms|Me|Dir|prof|Prof|sgt|Sgt|st|St|Col|Rev|Sen|Lt)\.</beforebreak>
          <afterbreak>\s*\W+</afterbreak>
        </rule>
	<rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(a\.m|A\.m|c|C|ca|Ca|cf|Cf|e\.g|E\.g|al|Al|ca|Ca|A\.D|etc|Etc|id|Id|q\.e\.d|Q\.e\.d|vs|Vs|seq|Seq|ib|Ib|ibid|Ibid|i\.e|I\.e|cit|Cit|N\.B|p\.m|P\.m|p\.m|P\.m|p\.s|P\.s|q\.v|Q\.v|sc|Sc|v|V|viz|Viz|v\.v|V\.v|appr|approx|addt|incl)\.</beforebreak>
          <afterbreak>\s*\W+</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(fig|Fig|chap|Chap|no|No|p|P|pg|Pg|pp|Pp|vol|Vol|approx|addt|addtl|incl|art|Art|op|Op)\.</beforebreak>
          <afterbreak>\s*[\dA-ZÁÃÄÅÀÂÆÇČÊËÉÈÍÌÎÏÑŒÓÔÕØÖŠÙÚÜÛŸÝa-zçéèêëàâäáæîïíìôöòõóøœřšûüùúñÿý]</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(Ian|Jan|Jaan|Tam|Sau|Led|Feb|Veeb|Hel|Vas|Un|Mar|Mär|Maal|Kov|Břez|Már|Apr|Huht|bal|dub|ápr|Mai|Maj|Maijs|Touk|geguž|máj|Iun|Jun|Jūn|Juun|Kes|birž|jún|Iul|Jul|Jūl|Juul|Hein|liep|júl|Aot|Aug|Elok|rugp|srp|avg|Sept|Syysk|rugs|szept|Oct|Okt|Lok,spal|rij|Noi|Nov|Mar|lapk|list|Dec|Det|Joul|gruod|prosjan|jan|Jan|feb|Feb|mar|Mar|apr|Apr|jun|Jun|jul|Jul|aug|Aug|sep|Sep|sept|Sept|oct|Oct|nov|Nov|dec|Dec)\.</beforebreak>
          <afterbreak>\s*\d+</afterbreak>
        </rule>
        <rule break="yes">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(b\.c|B\.c|B\.J|a\.c|A\.c|av|Av|Co|corp|Corp|dept|Dept|esp|Esp|D\.C|D\.P\.R\.K|D\.S|Fla|F\.W|gov|Gov|govt|Govt|inc|Inc|J\.D|J\.R|J\.T|Jr|Sr|Snr|L\.A|ltd|Ltd|mfg|Mfg|M\.B|M\.C|McG|Mt|M\.T\.M|N\.Y|O\.K|P\.F\.E|Sdn|S\.A|S\.A\.R\.L|S\.O\.S|S\.G|T\.R|U\.K|U\.S|U\.S\.A|V\.W\.H|W\.V|approx|addt|addtl|incl)\.</beforebreak>
          <afterbreak>\s+\"</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>(^|\s+|[\(\[\,\:\;\"\-])(b\.c|B\.c|B\.J|a\.c|A\.c|av|Av|Co|corp|Corp|dept|Dept|esp|Esp|D\.C|D\.P\.R\.K|D\.S|Fla|F\.W|gov|Gov|govt|Govt|inc|Inc|J\.D|J\.R|J\.T|Jr|Sr|Snr|L\.A|ltd|Ltd|mfg|Mfg|M\.B|M\.C|McG|Mt|M\.T\.M|N\.Y|O\.K|P\.F\.E|Sdn|S\.A|S\.A\.R\.L|S\.O\.S|S\.G|T\.R|U\.K|U\.S|U\.S\.A|V\.W\.H|W\.V|approx|addt|addtl|incl)\.</beforebreak>
          <afterbreak>\s+</afterbreak>
        </rule>
        <rule break="no">
          <beforebreak>\d+\.</beforebreak>
          <afterbreak>(^|\s+|[\(\[\,\:\;\"\-])(Ian|Jan|Jaan|Tam|Sau|Led|Feb|Veeb|Hel|Vas|Un|Mar|Mär|Maal|Kov|Břez|Már|Apr|Huht|bal|dub|ápr|Mai|Maj|Maijs|Touk|geguž|máj|Iun|Jun|Jūn|Juun|Kes|birž|jún|Iul|Jul|Jūl|Juul|Hein|liep|júl|Aot|Aug|Elok|rugp|srp|avg|Sept|Syysk|rugs|szept|Oct|Okt|Lok,spal|rij|Noi|Nov|Mar|lapk|list|Dec|Det|Joul|gruod|prosjan|jan|Jan|feb|Feb|mar|Mar|apr|Apr|jun|Jun|jul|Jul|aug|Aug|sep|Sep|sept|Sept|oct|Oct|nov|Nov|dec|Dec)</afterbreak>
        </rule>
      </languagerule>
