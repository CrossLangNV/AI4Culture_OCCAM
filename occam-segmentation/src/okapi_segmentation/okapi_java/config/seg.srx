          <afterbreak>\s*?[a-zçéèêëàâäáæîïíìôöòõóøœřšûüùúñÿýðþ0-9\(\)\-]</afterbreak>
        </rule>
        <!-- second part of consecutive abbreviations (cand. theol., o. fl.) -->
        <rule break="no">
          <beforebreak>(\s|\.)(theol|phil|oecon|med|mag|fl|s|meðf)\.</beforebreak>
          <afterbreak>\s*?[a-zçéèêëàâäáæîïíìôöòõóøœřšûüùúñÿýðþ0-9]</afterbreak>
        </rule>
      </languagerule>
